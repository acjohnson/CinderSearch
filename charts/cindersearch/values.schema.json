{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cluster", "s3", "data"],
  "properties": {
    "cluster": {
      "type": "object",
      "properties": {
        "topology": {
          "type": "string",
          "enum": ["single", "multi-node", "disaggregated"]
        },
        "domain": { "type": "string", "minLength": 1 },
        "discovery": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["hybrid", "s3", "static"]
            },
            "heartbeatSec": { "type": "integer", "minimum": 1 },
            "leaseTTLSec": { "type": "integer", "minimum": 2 },
            "syncSec": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "required": ["mode", "bucket", "region"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["minio", "external", "embedded"]
        },
        "bucket": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "minio": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["standalone", "distributed"]
            },
            "replicaCount": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "listenPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "flushSec": { "type": "integer", "minimum": 1 },
        "merge": {
          "type": "object",
          "properties": {
            "intervalSec": { "type": "integer", "minimum": 1 },
            "maxSegmentsPerShard": { "type": "integer", "minimum": 1 },
            "maxMergedSegmentMB": { "type": "integer", "minimum": 1 },
            "maxConcurrent": { "type": "integer", "minimum": 1 },
            "reclaimDeletesRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "s3GCGraceSec": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "nvmeMaxMB": { "type": "integer", "minimum": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["data", "coordinator", "reader"]
          }
        },
        "antiAffinity": {
          "type": "string",
          "enum": ["soft", "hard", "none"]
        },
        "drain": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "antiAffinity": {
          "type": "string",
          "enum": ["soft", "hard", "none"]
        }
      }
    },
    "reader": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "nvmeMaxMB": { "type": "integer", "minimum": 1 },
        "antiAffinity": {
          "type": "string",
          "enum": ["soft", "hard", "none"]
        }
      }
    }
  }
}
